# Cloudora Detection Queries

## Detection 1 - Password Spraying

index=cloudora sourcetype=cloudora:signin
| search result_code=50126
| stats count as failed_attempts by src_ip, user
| where failed_attempts >= 3
| stats dc(user) as unique_users, sum(failed_attempts) as total_failures by src_ip
| where unique_users >= 3
| sort - total_failures

## Detection 2 - Failed Authentication Followed by Success

index=cloudora sourcetype=cloudora:signin
| stats count(eval(result_code=50126)) as failed_attempts,
        count(eval(result="Success")) as successful_attempts
        by src_ip, user
| where failed_attempts >= 3 AND successful_attempts >= 1
| sort - failed_attempts

## Detection 3 - New Security Information Registration

index=cloudora sourcetype=cloudora:audit
| search operation="RegisterSecurityInfo"
| stats count by user, src_ip, device, target, action, result
| sort - count

## Detection 4 - New Inbox Rule

index=cloudora sourcetype=cloudora:audit
| search operation="New-InboxRule" action="Create" result="Success"
| table _time, user, src_ip, operation, target, device, action, result, details
| sort 0 _time
